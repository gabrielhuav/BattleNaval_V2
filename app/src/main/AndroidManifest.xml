<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BattleNaval_V2"
        tools:targetApi="31">

        <!--
            Las actividades no restringen orientacion ni tamano: Android 16 ignora
            esas restricciones en pantallas grandes y Play las senala como un
            problema de compatibilidad. android:configChanges evita que la
            actividad se recree al rotar o redimensionar, lo que conserva la
            partida en curso (importante en el modo Bluetooth, donde recrear la
            actividad cortaria el socket RFCOMM).
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".battlenavalbinario.SinglePlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />
        <activity
            android:name=".battlenavalbinario.BluetoothActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />
        <activity
            android:name=".battlenavalbinario.DeviceListActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />

        <activity
            android:name=".sistemabinario.EducationalActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />
        <activity
            android:name=".sistemabinario.GamesActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />
        <activity
            android:name=".codigoascii.AsciiEducationalActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />
        <activity
            android:name=".unidadesalmacenamiento.StorageUnitsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:exported="false" />
    </application>
</manifest>
